# Echte Werte kommen aus Vercel: vercel env pull .env
# Ohne Blob-Variablen speichert der lokale Dev-Server in .data/ (Wegwerfdaten).

# Blob-Store (private). Verbundene Projekte nutzen OIDC + BLOB_STORE_ID, alternativ ein Read-Write-Token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Zufälliger langer String zum Signieren der Session-Cookies (z. B. openssl rand -hex 32)
SESSION_SECRET=
